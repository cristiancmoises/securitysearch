</nav>
<!-- LOGO -->
<div class="logo">
<a href="/"><img src="./banner/securitysearch.webp" alt="Security Search"></a>
</div>
<!-- SEARCH FORM -->
<div class="search-wrap">
<form method="GET" action="web" class="searchbox" autocomplete="off">
<input type="text" name="s" placeholder="Search Security Search…" required autofocus>
<button type="submit" aria-label="Search">
<svg viewBox="0 0 24 24">
<path d="M10 2a8 8 0 105.293 14.707l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2z"/>
</svg>
</button>
</form>
</div>

